generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  // --- Requeridos al registrarse (perfil minimo para poder votar) ---
  gender    String // "mujer" | "hombre" | "otro" | "prefiero_no_decir"
  birthYear Int
  country   String // codigo ISO alpha-2, ej. "CO" (ver client/src/countries.js)

  // --- Opcionales, agregables despues desde el perfil ---
  // Mas campos completos = mas segmentacion disponible al ver resultados.
  occupation         String?
  education          String? // "primaria" | "secundaria" | "tecnico" | "universitario" | "posgrado"
  relationshipStatus String? // "soltero" | "en_pareja" | "casado" | "divorciado" | "otro"
  sexuality          String? // "heterosexual" | "homosexual" | "bisexual" | "otro" | "prefiero_no_decir"
  politicalLeaning   String? // "izquierda" | "centro" | "derecha" | "apolitico"
  religion           String? // "catolico" | "cristiano" | "musulman" | "judio" | "ateo_agnostico" | "otro"

  votes    Vote[]
  comments Comment[]
}

model Case {
  id          String   @id @default(cuid())
  title       String
  body        String // narrativa completa; parrafos separados por doble salto de linea
  sourceLinks Json? // [{ "label": "...", "url": "..." }], opcional
  createdAt   DateTime @default(now())

  polls Poll[]
}

model Poll {
  id        String   @id @default(cuid())
  category  String // "general" | "politics" | "technology" | "videogames" | "sexuality" | "entertainment"
  question  String
  // Si esta seteada, la encuesta es "pareada" (deteccion de honestidad): la
  // pregunta de control reutiliza el MISMO set de PollOption que la principal.
  counterQuestion String?
  // Si esta seteado, solo se puede votar si el usuario ya lleno ese campo
  // opcional de su perfil ("occupation" | "education" | "relationshipStatus" |
  // "sexuality" | "politicalLeaning" | "religion") — incentiva completar el
  // perfil a cambio de desbloquear mas encuestas.
  requiredProfileField String?
  // Si esta seteado, la pregunta pertenece a un caso narrado (varias
  // preguntas pueden compartir el mismo caso). SetNull: borrar el caso no
  // borra las preguntas, solo las deja sueltas.
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options  PollOption[]
  votes    Vote[]
  comments Comment[]
}

model PollOption {
  id        String @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int    @default(0)

  poll           Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votesAsMain    Vote[] @relation("MainOption")
  votesAsCounter Vote[] @relation("CounterOption")
}

model Vote {
  id              String   @id @default(cuid())
  pollId          String
  userId          String
  optionId        String
  counterOptionId String?
  createdAt       DateTime @default(now())

  poll          Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  option        PollOption  @relation("MainOption", fields: [optionId], references: [id])
  counterOption PollOption? @relation("CounterOption", fields: [counterOptionId], references: [id])

  @@unique([pollId, userId]) // un voto por usuario por encuesta, sin cambiarlo (v1)
  @@index([pollId, optionId])
}

model Comment {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pollId])
}
